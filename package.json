{
  "name": "@beremaran/opencode-agent-tree",
  "version": "0.9.2",
  "description": "OpenCode plugin that enforces task decomposition and delegates work to configurable subagents.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/v2.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./src/v2.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "default": "./src/v1.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-agent-tree#readme",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-agent-tree/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=1.18.11 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/index.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage test/index.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagent",
    "orchestration",
    "delegation",
    "agent",
    "task"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-agent-tree.git"
  },
  "license": "MIT",
  "funding": {
    "github": "beremaran"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.11 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
