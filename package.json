{
  "name": "opencode-agent-tree",
  "version": "0.1.0",
  "description": "Force opencode to act as an orchestrator: every task is decomposed and delegated to subagents, with user-configurable models per agent.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "orchestrator",
    "subagent",
    "task",
    "delegate",
    "swarm"
  ],
  "author": "opencode-agent-tree contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-agent-tree.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "typescript": "^5.6.0"
  }
}
