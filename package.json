{
  "name": "@beremaran/opencode-agent-tree",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Force opencode to act as an orchestrator: every task is decomposed and delegated to subagents, with user-configurable models per agent.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/index.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "orchestrator",
    "subagent",
    "task",
    "delegate",
    "swarm"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-agent-tree.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "typescript": "^5.6.0"
  }
}
