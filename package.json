{
  "name": "@beremaran/opencode-agent-tree",
  "version": "0.9.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Force opencode to act as an orchestrator: every task is decomposed and delegated to subagents, with user-configurable models per agent.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/v1.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./src/v2.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "default": "./src/v1.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-agent-tree",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-agent-tree/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=1.18.11 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/index.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage test/index.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "lint": "biome check src test",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "plugin",
    "orchestrator",
    "subagent",
    "task",
    "delegate",
    "swarm"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-agent-tree.git"
  },
  "license": "MIT",
  "funding": {
    "github": "beremaran"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.11 || ^0.0.0-beta"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
