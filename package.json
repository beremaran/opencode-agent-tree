{
  "name": "@beremaran/opencode-agent-tree",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Durable dynamic multi-agent workflows, delegation enforcement, model routing, resume, and workflow observability for opencode.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "orchestrator",
    "subagent",
    "delegation",
    "multi-agent",
    "dynamic-workflows",
    "workflow-engine",
    "ai-agent"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-agent-tree.git"
  },
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.11 <2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.11 <2",
    "@opencode-ai/sdk": ">=1.18.11 <2",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/keymap": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11",
    "@opencode-ai/sdk": "1.18.11",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "1.9.12",
    "@types/node": "^24.13.3",
    "typescript": "^5.6.0"
  }
}
